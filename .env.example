# ParkSpace environment configuration
#
#   cp .env.example .env      (then fill in the values)
#   npm run dev               (loads .env automatically)
#
# Leave a provider blank to disable it. A provider with no credentials
# gets no button at all — there is no demo fallback, because a button
# that signs anyone in without credentials is worse than no button.


# ─── Google sign-in ─────────────────────────────────────
# 1. https://console.cloud.google.com/ -> create (or pick) a project
# 2. APIs & Services -> OAuth consent screen
#      User type: External. Add yourself under "Test users" while the app
#      is in Testing, or nobody else can sign in.
#      Scopes needed: openid, .../auth/userinfo.email,
#                     .../auth/userinfo.profile
# 3. APIs & Services -> Credentials -> Create credentials
#      -> OAuth client ID -> Application type: Web application
# 4. Authorised redirect URIs -> add EXACTLY:
#      http://localhost:3001/api/auth/google/callback
#    (Google matches this string exactly: no trailing slash, right port.)
# 5. Copy the client ID and secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── Sign in with Apple ─────────────────────────────────
# Needs a PAID Apple Developer Program membership — a free account cannot
# create the Services ID this requires.
#
# 1. https://developer.apple.com/account -> Certificates, Identifiers & Profiles
# 2. Identifiers -> + -> App IDs -> App
#      Enable the "Sign in with Apple" capability. Note the Team ID
#      (top right of the portal, 10 characters).
# 3. Identifiers -> + -> Services IDs
#      Description: ParkSpace Web.  Identifier: com.yourname.parkspace.web
#      This identifier is the APPLE_CLIENT_ID below — NOT the App ID.
#      Configure -> Sign in with Apple:
#        Domains:       your-tunnel-subdomain.ngrok-free.app
#        Return URLs:   https://your-tunnel-subdomain.ngrok-free.app/api/auth/apple/callback
#      Apple REFUSES http and refuses localhost, so local development
#      needs an https tunnel (ngrok, cloudflared) and OAUTH_PUBLIC_URL
#      set to that https origin.
# 4. Keys -> + -> enable "Sign in with Apple" -> Register -> Download .p8
#      You can only download it ONCE. Note the 10-character Key ID.
# 5. Paste the whole .p8 below as a single line with \n for newlines:
#      APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----
#
# There is no client secret to copy: the server mints one per token
# request, as an ES256 JWT signed with this key (see server/apple.js).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=


# ─── GitHub sign-in ─────────────────────────────────────
# 1. https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# 2. Homepage URL:              http://localhost:5173
#    Authorization callback URL: http://localhost:3001/api/auth/github/callback
# 3. Generate a client secret and copy both values below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ─── URLs ───────────────────────────────────────────────
# Where the API is reachable from the browser. The provider redirects here,
# so it must match the registered redirect URI's origin.
OAUTH_PUBLIC_URL=http://localhost:3001

# Where the web app lives. The callback sends the browser back here.
APP_PUBLIC_URL=http://localhost:5173


# ─── Behind a TLS-inspecting corporate proxy ────────────
# The token exchange is a server-to-server HTTPS call. On a network that
# re-signs TLS certificates, Node rejects it with
# UNABLE_TO_GET_ISSUER_CERT_LOCALLY even though browsers work fine,
# because Windows trusts the proxy's root CA and Node does not.
#
# Export the corporate root CA to a PEM file and point Node at it:
#   NODE_EXTRA_CA_CERTS=C:/path/to/corporate-root-ca.pem
#
# Never use NODE_TLS_REJECT_UNAUTHORIZED=0 — that disables certificate
# checking for every outbound request.
# NODE_EXTRA_CA_CERTS=


# ─── Database ───────────────────────────────────────────
# Defaults to server/parkspace.db
# PARKSPACE_DB=
